---
import type { Brand, Product } from "@/config/types";
import ProductCover from "@/components/ProductCover.astro";

interface Props {
  brand: Brand;
  product: Product;
  contents: NonNullable<Product["contents"]>;
}
const { brand, product, contents } = Astro.props;
---

<section class="section section--alt">
  <div class="wrap contents">
    <div class="contents__side reveal">
      <h2>{contents.title}</h2>
      <p class="muted">
        {product.specs.map((s) => s.value).join(" · ")}
      </p>
      <div class="contents__cover">
        <ProductCover brand={brand} product={product} variant="card" />
      </div>
    </div>

    <ol class="modules">
      {
        contents.modules.map((m, i) => (
          <li class="module reveal">
            <span class="module__n">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{m.title}</h3>
              <p>{m.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .contents {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .contents__side {
    position: sticky;
    top: 100px;
  }
  .contents__side h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
  }
  .contents__cover {
    margin-top: 26px;
    max-width: 240px;
    transform: rotate(-3deg);
  }
  .modules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .module {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 22px;
  }
  .module__n {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--accent);
    min-width: 2ch;
    line-height: 1.3;
  }
  .module h3 {
    font-size: 1.15rem;
    margin: 0 0 2px;
  }
  .module p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }
  @media (max-width: 860px) {
    .contents {
      grid-template-columns: 1fr;
    }
    .contents__side {
      position: static;
    }
    .contents__cover {
      display: none;
    }
  }
</style>

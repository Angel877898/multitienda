---
import type { Brand, Product } from "@/config/types";

interface Props {
  brand: Brand;
  product: Product;
  /** "hero" = libro 3D grande; "card" = portada plana para tarjetas. */
  variant?: "hero" | "card";
}
const { brand, product, variant = "hero" } = Astro.props;
const c = product.cover;
---

<div class:list={["cover", `cover--${variant}`]} style={c.ratio ? `--cover-ratio:${c.ratio}` : undefined}>
  <div class="book">
    {
      c.image ? (
        <img class="book__face" src={c.image} alt={product.name} loading={variant === "hero" ? "eager" : "lazy"} decoding="async" />
      ) : (
        <div class="book__face book__face--gen" role="img" aria-label={`Portada: ${product.name}`}>
          <span class="book__orb book__orb--1" />
          <span class="book__orb book__orb--2" />
          <span class="book__kicker">{c.kicker}</span>
          <span class="book__title">{c.title}</span>
          {c.footer && <span class="book__footer">{c.footer}</span>}
          <span class="book__brand">
            <img src={brand.logoMark} alt="" width="18" height="18" />
            {brand.name}
          </span>
        </div>
      )
    }
  </div>
  {variant === "hero" && <span class="cover__chip">Libro de ayuda emocional</span>}
</div>

<style>
  .cover {
    position: relative;
    display: grid;
    place-items: center;
    perspective: 1600px;
  }
  .cover--hero {
    padding: 28px 18px 36px;
  }
  .cover--hero::before {
    content: "";
    position: absolute;
    inset: 6% 4%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--glow, var(--accent)) 30%, transparent),
      transparent
    );
    filter: blur(10px);
  }

  .book {
    position: relative;
    width: 100%;
    aspect-ratio: var(--cover-ratio, 17 / 22);
    transform-style: preserve-3d;
  }
  .cover--hero .book {
    max-width: 380px;
    transform: rotateY(-20deg) rotateX(4deg);
    transition: transform 0.6s ease;
  }
  .cover--hero:hover .book {
    transform: rotateY(-8deg) rotateX(2deg);
  }
  /* Canto de las páginas. */
  .cover--hero .book::after {
    content: "";
    position: absolute;
    top: 1.5%;
    bottom: 1.5%;
    right: -14px;
    width: 16px;
    background: repeating-linear-gradient(90deg, #f4f1ec 0 2px, #ddd6cc 2px 3px);
    transform: rotateY(90deg) translateZ(-1px);
    transform-origin: left;
    border-radius: 0 3px 3px 0;
  }

  .book__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px calc(var(--radius) * 0.5) calc(var(--radius) * 0.5) 4px;
    box-shadow:
      inset 6px 0 10px -4px rgb(0 0 0 / 0.35),
      0 30px 60px -20px rgb(0 0 0 / 0.45),
      0 10px 20px -10px rgb(0 0 0 / 0.25);
  }
  .cover--card .book__face {
    border-radius: calc(var(--radius) * 0.5);
    box-shadow: inset 5px 0 8px -4px rgb(0 0 0 / 0.3);
  }

  .book__face--gen {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 11% 10% 9%;
    color: var(--on-accent);
    background:
      linear-gradient(160deg, var(--accent) 0%, color-mix(in srgb, var(--accent) 45%, var(--dark)) 100%);
    container-type: inline-size;
  }
  .book__orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .book__orb--1 {
    width: 90%;
    aspect-ratio: 1;
    right: -38%;
    top: 30%;
    background: color-mix(in srgb, var(--highlight) 55%, transparent);
    mix-blend-mode: soft-light;
  }
  .book__orb--2 {
    width: 55%;
    aspect-ratio: 1;
    left: -20%;
    bottom: -12%;
    border: 2px solid color-mix(in srgb, var(--on-accent) 35%, transparent);
  }
  .book__kicker {
    position: relative;
    font-size: 5cqi;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .book__title {
    position: relative;
    margin-top: 6%;
    font-family: var(--font-heading);
    font-weight: var(--heading-weight);
    font-style: var(--hl-style);
    font-size: 13cqi;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .book__title::after {
    content: "";
    display: block;
    width: 22%;
    height: 4px;
    margin-top: 9%;
    border-radius: 4px;
    background: var(--highlight);
  }
  .book__footer {
    position: relative;
    margin-top: 6%;
    font-size: 4.6cqi;
    opacity: 0.9;
    max-width: 80%;
  }
  .book__brand {
    position: relative;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 4.6cqi;
    font-weight: 700;
  }
  .book__brand img {
    width: 7cqi;
    height: 7cqi;
    border-radius: 3px;
    background: #fff;
    padding: 1px;
  }

  .cover__chip {
    position: absolute;
    bottom: 10px;
    left: 50%;
    translate: -50% 0;
    white-space: nowrap;
    background: var(--surface);
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover--hero .book {
      transform: none;
    }
  }
</style>

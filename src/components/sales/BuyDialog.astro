---
// Ventana de compra: pide el correo y redirige a Mercado Pago.
// Cualquier elemento con [data-buy] en la página la abre, y también el enlace
// directo dominio.com/<producto>#pagar (útil para anuncios).
// En móvil se muestra como panel inferior ("bottom sheet") con scroll propio.
import type { Product } from "@/config/types";
import Price from "@/components/ui/Price.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<dialog id="buy-dialog" class="buy" aria-labelledby="buy-title" data-product-id={product.id}>
  <form class="buy__card" novalidate>
    <span class="buy__grip" aria-hidden="true"></span>
    <button type="button" class="buy__x" data-close aria-label="Cerrar">✕</button>

    <p class="eyebrow">Estás a un paso</p>
    <h2 id="buy-title" class="buy__title">{product.name}</h2>
    <Price product={product} size="md" />

    <label class="buy__field">
      <span>¿A qué correo te enviamos tu PDF?</span>
      <input
        type="email"
        name="email"
        inputmode="email"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        placeholder="tucorreo@ejemplo.com"
        required
      />
    </label>
    <p class="buy__err" role="alert" hidden></p>

    <button type="submit" class="btn btn-cta btn-lg btn-block">
      <Icon name="lock" size={18} />
      <span data-label>Continuar al pago seguro</span>
    </button>

    <ul class="buy__methods" aria-label="Métodos de pago">
      <li>Tarjeta</li>
      <li>OXXO</li>
      <li>SPEI</li>
      <li>Mercado Pago</li>
    </ul>
    <p class="buy__note">
      Serás redirigido a Mercado Pago. Al confirmarse el pago descargas tu PDF al instante y también
      te llega por correo.
    </p>
  </form>
</dialog>

<script>
  const dialog = document.getElementById("buy-dialog") as HTMLDialogElement | null;
  if (dialog) {
    const form = dialog.querySelector("form")!;
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const err = form.querySelector<HTMLParagraphElement>(".buy__err")!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = submit.querySelector<HTMLSpanElement>("[data-label]")!;
    const idleLabel = label.textContent;
    // Navegadores antiguos (algunos Android/iOS) no soportan <dialog>.
    const native = typeof dialog.showModal === "function";
    const touch = window.matchMedia("(pointer: coarse)").matches;

    const open = () => {
      err.hidden = true;
      if (native) dialog.showModal();
      else dialog.setAttribute("open", "");
      document.documentElement.classList.add("buy-open");
      if (!native) document.documentElement.classList.add("buy-fallback");
      // En celulares no abrimos el teclado de golpe: tapa el formulario.
      if (!touch) input.focus();
    };
    const close = () => {
      if (native) dialog.close();
      else dialog.removeAttribute("open");
      document.documentElement.classList.remove("buy-open", "buy-fallback");
    };
    dialog.addEventListener("close", () => document.documentElement.classList.remove("buy-open"));

    const showError = (msg: string) => {
      err.textContent = msg;
      err.hidden = false;
    };

    document.querySelectorAll("[data-buy]").forEach((el) =>
      el.addEventListener("click", (e) => {
        e.preventDefault();
        open();
      })
    );
    dialog.querySelector("[data-close]")!.addEventListener("click", close);
    // Cerrar al tocar fuera del panel.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && dialog.hasAttribute("open")) close();
    });
    // Que el campo quede visible cuando aparece el teclado.
    input.addEventListener("focus", () => {
      setTimeout(() => input.scrollIntoView({ block: "center", behavior: "smooth" }), 300);
    });

    if (location.hash === "#pagar") open();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError("Revisa tu correo: ahí te enviaremos el PDF.");
        input.focus();
        return;
      }
      err.hidden = true;
      submit.disabled = true;
      label.textContent = "Conectando con Mercado Pago…";
      try {
        const res = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, productId: dialog.dataset.productId }),
        });
        const data = (await res.json().catch(() => ({}))) as { url?: string; error?: string };
        if (!res.ok || !data.url) throw new Error(data.error || "No se pudo iniciar el pago.");
        window.location.href = data.url;
      } catch (e) {
        showError(e instanceof Error ? e.message : "Ocurrió un error. Intenta de nuevo.");
        submit.disabled = false;
        label.textContent = idleLabel;
      }
    });
  }
</script>

<style>
  .buy {
    border: none;
    padding: 0;
    margin: auto;
    background: transparent;
    width: min(460px, calc(100% - 28px));
    max-width: 100%;
    max-height: calc(100vh - 28px);
    max-height: calc(100dvh - 28px);
    overflow: visible;
    color: var(--text);
  }
  .buy:not([open]) {
    display: none;
  }
  .buy::backdrop {
    background: rgb(10 10 20 / 0.6);
  }
  /* Respaldo para navegadores sin <dialog>: panel fijo con fondo oscuro. */
  :global(html.buy-open) {
    overflow: hidden;
  }
  :global(html.buy-fallback body)::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgb(10 10 20 / 0.6);
  }
  .buy[open] {
    position: fixed;
    inset: 0;
    height: -webkit-fit-content;
    height: fit-content;
    z-index: 1000;
    animation: pop 0.22s ease-out;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .buy__card {
    position: relative;
    background: var(--surface);
    border-radius: var(--radius);
    padding: 30px 26px 24px;
    display: grid;
    gap: 14px;
    max-height: inherit;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.5);
  }
  .buy__grip {
    display: none;
  }
  .buy__x {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--surface-alt);
    color: var(--muted);
    cursor: pointer;
    font-size: 1rem;
  }
  .buy .eyebrow {
    margin: 0;
  }
  .buy__title {
    font-size: 1.35rem;
    margin: 0;
    padding-right: 40px;
    line-height: 1.2;
  }
  .buy__field {
    display: grid;
    gap: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    margin-top: 4px;
  }
  .buy__field input {
    width: 100%;
    font: inherit;
    font-weight: 400;
    /* 16px o más evita que iOS haga zoom al escribir. */
    font-size: max(16px, 1.05rem);
    padding: 15px 16px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    -webkit-appearance: none;
    appearance: none;
  }
  .buy__field input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .buy__err {
    margin: 0;
    color: #b42318;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .buy .btn-block {
    min-height: 56px;
    padding: 14px 18px;
    white-space: normal;
  }
  .buy__methods {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .buy__methods li {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 4px 9px;
  }
  .buy__note {
    margin: 0;
    text-align: center;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* Móvil: panel que sube desde abajo, a todo el ancho. */
  @media (max-width: 560px) {
    .buy {
      width: 100%;
      max-height: 92vh;
      max-height: 92dvh;
      margin: auto 0 0;
    }
    .buy[open] {
      inset: auto 0 0 0;
    }
    .buy__card {
      border-radius: calc(var(--radius) + 4px) calc(var(--radius) + 4px) 0 0;
      padding: 14px 20px calc(20px + env(safe-area-inset-bottom));
      gap: 12px;
    }
    .buy__grip {
      display: block;
      justify-self: center;
      width: 44px;
      height: 5px;
      border-radius: 999px;
      background: var(--line);
      margin-bottom: 4px;
    }
    .buy__x {
      top: 16px;
      right: 14px;
    }
    .buy__title {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .buy[open] {
      animation: none;
    }
  }
</style>

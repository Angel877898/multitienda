# ─── Copia este archivo como .env y rellena los valores (solo para desarrollo local) ───
# ⚠️ Este archivo SÍ se sube a GitHub: nunca pongas aquí llaves reales.
# En Cloudflare estos valores se configuran como "secrets" (ver README).

# ⭐ Tienda que ves en local. Opciones: sanacion-interior | guias-tus-examenes
BRAND=sanacion-interior

# Stripe (https://dashboard.stripe.com/test/apikeys). Usa las de PRUEBA (sk_test_ / pk_test_) en local.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Secreto del webhook (whsec_…): Stripe → Desarrolladores → Webhooks, o `stripe listen` en local.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Clave para firmar los enlaces de descarga. Debe ser LA MISMA en todas las tiendas.
# Generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_SECRET=cambia-esto-por-una-cadena-larga-y-secreta

# API key de Resend (https://resend.com) para enviar los correos de entrega.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

---
import type { Brand, Product } from "@/config/types";
import ProductCover from "@/components/ProductCover.astro";
import Headline from "@/components/ui/Headline.astro";
import Price from "@/components/ui/Price.astro";
import Icon from "@/components/ui/Icon.astro";
import { mergeTheme } from "@/lib/theme";

interface Props {
  brand: Brand;
  product: Product;
}
const { brand, product } = Astro.props;
const h = product.hero;
const dark = mergeTheme(brand.theme, product.theme).heroStyle === "dark";
---

<section class:list={["hero", { "hero--dark": dark }]}>
  <div class="wrap hero__in">
    <div class="hero__copy">
      <div class="hero__tags">
        {product.emblem && <img class="hero__emblem" src={product.emblem} alt="" width="44" height="44" />}
        <span class="eyebrow">{h.eyebrow}</span>
        {product.badge && <span class="badge">{product.badge}</span>}
      </div>
      <Headline text={h.headline} class="hero__title" />
      <p class="hero__sub">{h.subheadline}</p>

      <ul class="checks hero__bullets">
        {
          h.bullets.map((b) => (
            <li>
              <Icon name="check" size={20} />
              <span>{b}</span>
            </li>
          ))
        }
      </ul>

      <div class="hero__buy" id="comprar">
        <div class="hero__price">
          <Price product={product} />
          <span class="hero__once">Pago único · PDF para siempre</span>
        </div>
        <button type="button" class="btn btn-cta btn-lg hero__cta" data-buy>
          Quiero mi PDF ahora
          <Icon name="download" size={20} />
        </button>
        <div class="hero__trust">
          <span><Icon name="lock" size={16} /> Pago seguro con tarjeta</span>
          <span><Icon name="download" size={16} /> Acceso inmediato</span>
          {brand.guarantee && <span><Icon name="shield" size={16} /> Garantía de satisfacción</span>}
        </div>
      </div>
    </div>

    <div class="hero__media">
      <ProductCover brand={brand} product={product} />
    </div>
  </div>

  <div class="wrap">
    <dl class="specs">
      {
        product.specs.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(36px, 6vw, 72px) 0 40px;
    background:
      radial-gradient(1200px 500px at 85% -10%, color-mix(in srgb, var(--accent) 10%, transparent), transparent),
      var(--bg);
  }
  .hero__in {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-bottom: 18px;
  }
  .hero__emblem {
    width: 44px;
    height: 44px;
  }
  :global(.hero__title) {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 18px;
  }
  .hero__sub {
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    color: var(--muted);
    margin: 0 0 24px;
    max-width: 54ch;
  }
  .hero__bullets {
    margin-bottom: 30px;
    font-weight: 600;
  }
  .hero__buy {
    display: grid;
    gap: 16px;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 24px 50px -30px rgb(0 0 0 / 0.25);
    max-width: 520px;
    scroll-margin-top: 90px;
  }
  .hero__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
  }
  .hero__once {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .hero__cta {
    width: 100%;
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 600;
  }
  .hero__trust span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero__trust :global(svg) {
    color: var(--accent);
  }

  .specs {
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .specs div {
    padding: 18px 22px;
    border-left: 1px solid var(--line);
  }
  .specs div:first-child {
    border-left: none;
  }
  .specs dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }
  .specs dd {
    margin: 4px 0 0;
    font-weight: 700;
  }

  /* --- Hero oscuro: fondo de la portada, resplandor y patrón --- */
  .hero--dark {
    color: var(--on-dark);
    background:
      radial-gradient(700px 520px at 78% 38%, color-mix(in srgb, var(--glow) 60%, transparent), transparent 70%),
      var(--pattern),
      linear-gradient(180deg, var(--dark), color-mix(in srgb, var(--dark) 70%, #000));
    background-size: auto, 400px, auto;
  }
  .hero--dark .eyebrow {
    color: var(--highlight);
  }
  .hero--dark .badge {
    background: color-mix(in srgb, var(--highlight) 18%, transparent);
    color: var(--highlight);
  }
  .hero--dark :global(.hl) {
    color: var(--highlight);
    background: none;
    text-decoration: underline 3px color-mix(in srgb, var(--highlight) 55%, transparent);
    text-underline-offset: 0.16em;
  }
  .hero--dark .hero__sub,
  .hero--dark .hero__once,
  .hero--dark .hero__trust {
    color: color-mix(in srgb, var(--on-dark) 75%, transparent);
  }
  .hero--dark .checks :global(svg),
  .hero--dark .hero__trust :global(svg) {
    color: var(--highlight);
  }
  .hero--dark .hero__buy,
  .hero--dark .specs {
    background: color-mix(in srgb, var(--on-dark) 7%, transparent);
    border-color: color-mix(in srgb, var(--highlight) 30%, transparent);
    backdrop-filter: blur(6px);
  }
  .hero--dark .specs div {
    border-color: color-mix(in srgb, var(--highlight) 20%, transparent);
  }
  .hero--dark .specs dt {
    color: var(--highlight);
  }
  .hero--dark :global(.price__was) {
    color: color-mix(in srgb, var(--on-dark) 60%, transparent);
  }
  /* Borde dorado para que la portada se despegue del fondo oscuro. */
  .hero--dark :global(.book__face) {
    outline: 1px solid color-mix(in srgb, var(--highlight) 45%, transparent);
    outline-offset: -1px;
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--highlight) 10%, transparent),
      0 40px 80px -24px rgb(0 0 0 / 0.7),
      0 0 90px -10px color-mix(in srgb, var(--glow) 70%, transparent);
  }
  .hero--dark :global(.cover__chip) {
    background: var(--dark);
    color: var(--on-dark);
    border-color: color-mix(in srgb, var(--highlight) 40%, transparent);
  }

  @media (max-width: 880px) {
    .hero {
      padding-top: 20px;
    }
    .hero__in {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .hero__media {
      order: -1;
      max-width: 150px;
      margin: 0 auto;
      width: 100%;
    }
    .hero__media :global(.cover--hero) {
      padding: 10px 8px 26px;
    }
    /* En móvil la caja de compra va justo después del titular. */
    .hero__copy {
      display: flex;
      flex-direction: column;
    }
    .hero__tags {
      justify-content: center;
      margin-bottom: 10px;
    }
    .hero__tags .badge,
    .hero__emblem {
      display: none;
    }
    :global(.hero__title) {
      font-size: clamp(1.75rem, 7.4vw, 2.3rem);
      text-align: center;
      margin-bottom: 14px;
    }
    .hero__sub {
      order: 3;
      margin-top: 22px;
      font-size: 1rem;
    }
    .hero__bullets {
      order: 4;
      margin-bottom: 0;
    }
    .hero__buy {
      order: 2;
      padding: 16px;
      gap: 12px;
      max-width: none;
    }
    .specs div {
      border-left: none;
      border-top: 1px solid var(--line);
    }
    .specs div:first-child {
      border-top: none;
    }
  }
</style>

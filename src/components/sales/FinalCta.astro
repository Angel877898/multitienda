---
import type { Brand, Product } from "@/config/types";
import ProductCover from "@/components/ProductCover.astro";
import Headline from "@/components/ui/Headline.astro";
import Price from "@/components/ui/Price.astro";

interface Props {
  brand: Brand;
  product: Product;
}
const { brand, product } = Astro.props;
---

<section class="section section--dark final">
  <div class="wrap final__in">
    <div class="final__copy reveal">
      <Headline as="h2" text={product.hero.headline} class="final__title" />
      <p class="final__sub">{product.summary}</p>
      <div class="final__price">
        <Price product={product} />
      </div>
      <button type="button" class="btn btn-cta btn-lg" data-buy>Sí, lo quiero ahora</button>
    </div>
    <div class="final__cover reveal">
      <ProductCover brand={brand} product={product} />
    </div>
  </div>
</section>

<style>
  .final {
    overflow: hidden;
    background:
      radial-gradient(640px 460px at 80% 50%, color-mix(in srgb, var(--glow) 50%, transparent), transparent 70%),
      var(--pattern),
      var(--dark);
    background-size: auto, 400px, auto;
  }
  .final__in {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
  }
  :global(.final__title) {
    font-size: clamp(1.9rem, 4vw, 3rem);
    color: var(--on-dark);
  }
  .final :global(.hl) {
    color: var(--highlight);
    background: none;
  }
  .final__sub {
    font-size: 1.1rem;
    opacity: 0.8;
    margin: 0 0 24px;
    max-width: 50ch;
  }
  .final__price {
    margin-bottom: 22px;
  }
  /* Sobre fondo oscuro el botón usa el color de resalte para destacar. */
  .final .btn-cta {
    background: var(--highlight);
    color: var(--dark);
    box-shadow: 0 14px 30px -12px color-mix(in srgb, var(--highlight) 60%, #000);
  }
  .final :global(.price__was) {
    color: color-mix(in srgb, var(--on-dark) 60%, transparent);
  }
  .final :global(.price__off) {
    color: var(--dark);
    background: var(--highlight);
  }
  .final__cover {
    max-width: 320px;
    justify-self: center;
    width: 100%;
  }
  .final :global(.book__face) {
    outline: 1px solid color-mix(in srgb, var(--highlight) 45%, transparent);
    outline-offset: -1px;
  }
  .final :global(.cover__chip) {
    display: none;
  }
  @media (max-width: 820px) {
    .final__in {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .final__sub {
      margin-inline: auto;
    }
    .final :global(.price) {
      justify-content: center;
    }
    .final__cover {
      display: none;
    }
  }
</style>
